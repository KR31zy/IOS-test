DATABASE_URL=postgresql+psycopg://anirepro:change-me@localhost:5432/anirepro
SESSION_SECRET=replace-with-a-cryptographically-random-64-character-value
APP_ENV=development
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Production initial setup must be explicitly enabled only during bootstrap:
ALLOW_INITIAL_SETUP=false
# Secret 32-byte key encoded as base64. Back up securely; rotating needs re-encryption.
FILE_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
ATTACHMENTS_DIR=./private-attachments
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# TLS enforced for password reset messages
RESET_URL_BASE=http://localhost:8080/login?reset_token=
# Farm team invitation base. Development returns links to managers; production emails links over SMTP.
INVITE_URL_BASE=http://localhost:8080/join?token=

# Optional Google / Apple browser-based social auth (HTTPS public API origin only)
SOCIAL_PUBLIC_ORIGIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_FILE=
